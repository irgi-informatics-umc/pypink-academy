---
import lessons from '../data/lessons.json';
---
<header class="header">
  <nav class="nav wrap" aria-label="Navigasi utama">
    <a class="brand" href="/" aria-label="PyPink Academy beranda">
      <svg viewBox="0 0 64 64" aria-hidden="true"><rect x="3" y="3" width="58" height="58" rx="19" fill="#ff8fb8" stroke="#3b1f5c" stroke-width="4"/><path d="M15 43c-8 0-9-10 1-11s17 5 22 0c6-5 0-16-8-11-5 3-2 9 4 7" fill="none" stroke="#a7f3d0" stroke-width="6" stroke-linecap="round"/><circle cx="41" cy="24" r="13" fill="#a7f3d0" stroke="#3b1f5c" stroke-width="3"/><circle cx="37" cy="22" r="1.8" fill="#3b1f5c"/><circle cx="46" cy="22" r="1.8" fill="#3b1f5c"/><path d="M38 28q4 4 8 0" fill="none" stroke="#3b1f5c" stroke-width="2"/></svg>
      <span>PyPink</span>
    </a>
    <div class="navlinks"><a href="/belajar/">Peta belajar</a><a href="/latihan/">Latihan</a><a href="/cheatsheet/">Cheatsheet</a><a href="/playground/">Playground</a><a href="/tentang/">Tentang</a></div>
    <div class="nav-actions">
      <span class="pill streak" data-streak title="Streak belajar">🔥 0 hari</span>
      <span class="pill global-progress" title="Progres seluruh materi" data-progress-total={lessons.length}><span aria-hidden="true">▥</span> <span data-global-progress>0%</span></span>
      <button class="btn small theme-toggle" data-theme-toggle aria-label="Aktifkan mode gelap"><span aria-hidden="true">☾</span><span class="theme-label">Mode</span></button>
      <a class="btn primary small start-link" href="/belajar/">Mulai Belajar →</a>
      <button class="btn menu-toggle" data-menu-toggle aria-label="Buka menu" aria-controls="mobile-drawer" aria-expanded="false"><span aria-hidden="true">☰</span></button>
    </div>
  </nav>
</header>
