---
import BaseLayout from '../layouts/BaseLayout.astro';
import Pipi from '../components/MascotPipi.astro';
import lessons from '../data/lessons.json';
const levels=[['Kenalan dulu','Mengenal Python dan menyiapkan alat','🌱'],['Dasar-dasar','Data, input, output, dan operator','🧃'],['Alur program','Pilihan, loop, dan logika','🧠'],['Struktur data','Simpan dan olah koleksi data','🧺'],['Fungsi & modul','Susun kode jadi resep yang bisa dipakai lagi','🧁'],['Lebih serius','File, OOP, paket, dan dokumentasi','🛠️'],['Kode kompleks','Teknik lanjut dan proyek akhir','🚀']];
---
<BaseLayout>
  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <span class="eyebrow sticker">🐍 Teman ngoding pertamamu</span>
          <h1>Python jadi <em>gampang</em>, belajarnya santai!</h1>
          <p class="lead">Belajar Python tanpa pusing, dijelasin pelan-pelan sambil ngemil. Dari nol sampai bikin proyekmu sendiri, ditemani Pipi si ular kecil.</p>
          <div class="hero-actions"><a class="btn primary" href="/belajar/" data-heart>Mulai dari Nol <span aria-hidden="true">→</span></a><a class="btn" href="/belajar/">Lihat Peta Belajar</a></div>
          <span class="pill"><span aria-hidden="true">♥</span> Gratis · santai · cocok buat pemula</span>
        </div>
        <div class="hero-art"><div class="hero-blob"></div><span class="spark one" aria-hidden="true">✦</span><span class="spark two" aria-hidden="true">♥</span><span class="hero-cloud" aria-hidden="true">☁</span><Pipi/></div>
      </div>
    </section>
    <div class="wave" aria-hidden="true"></div>
    <section class="section alt"><div class="wrap features-section"><div class="section-heading"><span class="eyebrow">Kenalan dulu, yuk</span><h2>Belajar yang rasanya <span class="highlight">kayak dibantu teman</span></h2><p>Langkah kecil yang bikin kamu berani mencoba.</p></div><div class="grid features"><article class="card feature-card"><span class="icon-tile">💬</span><h3>Bahasa manusia</h3><p>Istilah teknis dijelaskan pelan-pelan, pakai analogi sehari-hari.</p></article><article class="card feature-card"><span class="icon-tile lav-tile">⌘</span><h3>Kode yang nyata</h3><p>Contoh kecil yang bisa kamu pahami dan ubah sendiri.</p></article><article class="card feature-card"><span class="icon-tile peach-tile">✦</span><h3>Latihan tiap bab</h3><p>Latihan singkat membantu konsepnya menempel, bukan sekadar lewat.</p></article><article class="card feature-card"><span class="icon-tile sky-tile">▶</span><h3>Langsung dicoba</h3><p>Eksperimen kode di playground mini tanpa memasang apa pun.</p></article></div></div></section>
    <section class="section adventure"><div class="wrap"><div class="section-heading adventure-heading"><div><span class="eyebrow sticker">Peta petualangan</span><h2>Dari halo sampai <span class="highlight">proyek!</span></h2><p>7 level, langkah kecil, progres tersimpan di perangkatmu.</p></div><a class="text-link" href="/belajar/">Lihat semua materi →</a></div><div class="grid level-grid">{levels.map(([name,desc,emoji],i)=><a class="card level-card" href="/belajar/"><div class="level-num">{emoji} <span>0{i+1}</span></div><h3>{name}</h3><p>{desc}</p><div class="progress-track"><div class="progress-fill" data-progress-bar data-level={i+1} data-total={lessons.filter(x=>x.level===i+1).length||1}></div></div></a>)}</div></div></section>
    <section class="section alt stats-section"><div class="wrap"><span class="eyebrow">Kemajuanmu dimulai dari sini</span><h2>Angka kecil, mimpi besar ✨</h2><div class="grid stats"><div class="card stat"><strong>{lessons.length}</strong><span>materi belajar</span></div><div class="card stat"><strong>7</strong><span>level petualangan</span></div><div class="card stat"><strong>∞</strong><span>kesempatan mencoba lagi</span></div></div></div></section>
    <section class="section"><div class="wrap"><div class="cta"><span class="eyebrow">Pipi sudah siap!</span><h2>Satu baris kode pertama dimulai dari sini.</h2><p>Ambil camilanmu. Kita belajar bareng-bareng.</p><a class="btn" href="/belajar/" data-heart>Mulai petualangan <span aria-hidden="true">♥</span></a><span class="cta-spark" aria-hidden="true">✦</span></div></div></section>
  </main>
</BaseLayout>
