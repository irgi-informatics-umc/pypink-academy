import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
const groups=[
 {title:'Tipe data',icon:'fa-cubes',color:'var(--mint)',code:`nama_kucing = "Mochi"\numur = 4\nharga = 12500.5\nsudah_makan = True\nwarna = None\nprint(type(nama_kucing).__name__)`,file:'tipe_data.py'},
 {title:'Operator',icon:'fa-calculator',color:'var(--butter)',code:`uang = 50000\nharga = 18000\nsisa = uang - harga\njumlah_porsi = uang // harga\nada_kembalian = sisa > 0\nprint(sisa, jumlah_porsi, ada_kembalian)`,file:'operator.py'},
 {title:'String method & f-string',icon:'fa-font',color:'var(--peach)',code:`playlist = "  lagu kucing  "\nrapi = playlist.strip().title()\nprint(f"Playlist: {rapi}")\nprint(rapi.replace("Kucing", "Meong"))`,file:'string.py'},
 {title:'List, tuple, set, dict',icon:'fa-layer-group',color:'var(--lav)',code:`camilan = ["mochi", "roti"]\ncamilan.append("puding")\nwarna = ("pink", "mint")\nlabel_unik = set(["vegan", "vegan", "pedas"])\nprofil = {"nama": "Mochi", "umur": 4}\nprint(camilan, warna, label_unik, profil["nama"])`,file:'koleksi.py'},
 {title:'Perulangan & comprehension',icon:'fa-repeat',color:'var(--sky)',code:`harga = [8, 12, 20]\ndiskon = [nilai * 0.9 for nilai in harga if nilai >= 10]\nfor urutan, nilai in enumerate(diskon, start=1):\n    print(urutan, nilai)`,file:'loop.py'},
 {title:'Fungsi & lambda',icon:'fa-cookie-bite',color:'var(--pink)',code:`def sapa(nama, sapaan="Halo"):\n    return f"{sapaan}, {nama}!"\n\nurutkan = lambda lagu: lagu.lower()\nprint(sapa("Mira"))\nprint(urutkan("Meongpop"))`,file:'fungsi.py'},
 {title:'OOP',icon:'fa-shapes',color:'var(--lav)',code:`class Kucing:\n    def __init__(self, nama):\n        self.nama = nama\n\n    def menyapa(self):\n        return f"Meong, aku {self.nama}!"\n\nprint(Kucing("Mochi").menyapa())`,file:'oop.py'},
 {title:'File & exception',icon:'fa-file-lines',color:'var(--peach)',code:`from pathlib import Path\n\ncatatan = Path("catatan.txt")\ntry:\n    catatan.write_text("Beli mochi", encoding="utf-8")\n    print(catatan.read_text(encoding="utf-8"))\nexcept OSError as error:\n    print(f"File bermasalah: {error}")`,file:'file.py'},
 {title:'JSON & request API',icon:'fa-cloud-arrow-down',color:'var(--mint)',code:`import json\n\nprofil = {"nama": "Mira", "favorit": ["Python", "mochi"]}\nteks = json.dumps(profil, ensure_ascii=False)\nlagi = json.loads(teks)\nprint(lagi["favorit"][0])`,file:'json.py'}
];
