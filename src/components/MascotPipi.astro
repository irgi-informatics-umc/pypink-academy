---
const { class: className = 'pipi', mood = 'normal' } = Astro.props;
---
<svg class={className} viewBox="0 0 320 300" role="img" aria-label={`Pipi si ular Python (${mood})`}>
  <!-- Snake body -->
  <path d="M83 232c-37 0-55-26-42-53 12-25 48-22 77-14 34 9 68 6 81-18 10-18 0-36-19-40-19-4-33 8-31 23 2 13 17 18 28 10" fill="none" stroke="#3b1f5c" stroke-width="31" stroke-linecap="round"/>
  <path d="M83 232c-37 0-55-26-42-53 12-25 48-22 77-14 34 9 68 6 81-18 10-18 0-36-19-40-19-4-33 8-31 23 2 13 17 18 28 10" fill="none" stroke="#a7f3d0" stroke-width="23" stroke-linecap="round"/>
  
  <!-- Head -->
  <ellipse cx="193" cy="104" rx="65" ry="59" fill="#a7f3d0" stroke="#3b1f5c" stroke-width="7"/>
  
  <!-- Cute little horns / snake crest -->
  <path d="M157 66q-21-33-4-40 18-7 24 25M212 49q9-28 27-20 14 7-1 37" fill="#a7f3d0" stroke="#3b1f5c" stroke-width="7" stroke-linecap="round"/>

  {mood === 'lost' ? (
    <!-- 404 / Lost expression: dizzy swirl eyes and question mark -->
    <>
      <path d="M172 97q5-5 10 0t-10 0" fill="none" stroke="#3b1f5c" stroke-width="4" stroke-linecap="round"/>
      <path d="M207 97q5-5 10 0t-10 0" fill="none" stroke="#3b1f5c" stroke-width="4" stroke-linecap="round"/>
      <ellipse cx="195" cy="122" rx="7" ry="5" fill="#3b1f5c"/>
      <g transform="translate(245, 45)">
        <circle cx="12" cy="12" r="14" fill="#fde68a" stroke="#3b1f5c" stroke-width="3"/>
        <text x="12" y="19" font-family="'Baloo 2', sans-serif" font-size="18" font-weight="800" fill="#3b1f5c" text-anchor="middle">?</text>
      </g>
    </>
  ) : mood === 'thinking' ? (
    <>
      <path d="M169 100q7-7 14 0m22 0q7-7 14 0" fill="none" stroke="#3b1f5c" stroke-width="5" stroke-linecap="round"/>
      <path d="M183 125q12-9 24 0" fill="none" stroke="#3b1f5c" stroke-width="5" stroke-linecap="round"/>
      <circle cx="250" cy="48" r="8" fill="#fde68a" stroke="#3b1f5c" stroke-width="3"/><circle cx="267" cy="32" r="12" fill="#fde68a" stroke="#3b1f5c" stroke-width="3"/><text x="267" y="38" text-anchor="middle" font-size="17" font-weight="800" fill="#3b1f5c">?</text>
    </>
  ) : mood === 'celebrate' ? (
    <!-- Happy / Celebrate expression: ^ ^ eyes and party sparkle -->
    <>
      <path d="M170 100q7-10 14 0" fill="none" stroke="#3b1f5c" stroke-width="5" stroke-linecap="round"/>
      <path d="M205 100q7-10 14 0" fill="none" stroke="#3b1f5c" stroke-width="5" stroke-linecap="round"/>
      <path d="M181 118q14 16 28 0" fill="none" stroke="#3b1f5c" stroke-width="5" stroke-linecap="round"/>
      <path d="M187 40l10 -25l10 25z" fill="#ff5c9a" stroke="#3b1f5c" stroke-width="3"/>
      <circle cx="197" cy="13" r="4" fill="#fde68a"/>
    </>
  ) : (
    <!-- Normal / Twinkle cute expression -->
    <>
      <ellipse cx="177" cy="97" rx="6" ry="9" fill="#3b1f5c" class="blink"/>
      <ellipse cx="212" cy="97" rx="6" ry="9" fill="#3b1f5c" class="blink"/>
      <circle cx="175" cy="94" r="2" fill="#ffffff"/>
      <circle cx="210" cy="94" r="2" fill="#ffffff"/>
      <!-- Smile & forked tongue -->
      <path d="M181 122q13 13 27 0" fill="none" stroke="#3b1f5c" stroke-width="5" stroke-linecap="round"/>
      <path d="M195 132v14m0 0q-12 8-14 0m14 0q12 8 14 0" fill="none" stroke="#ff5c9a" stroke-width="4" stroke-linecap="round"/>
    </>
  )}

  <!-- Pink blush cheeks -->
  <circle cx="154" cy="114" r="9" fill="#ff8fb8"/>
  <circle cx="231" cy="114" r="9" fill="#ff8fb8"/>
</svg>
